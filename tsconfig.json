{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@mios/domain": ["packages/domain/src/index.ts"],
      "@mios/domain/*": ["packages/domain/src/*"],
      "@mios/database": ["packages/database/src/index.ts"],
      "@mios/database/*": ["packages/database/src/*"],
      "@mios/connectors": ["packages/connectors/src/index.ts"],
      "@mios/connectors/*": ["packages/connectors/src/*"],
      "@mios/intelligence": ["packages/intelligence/src/index.ts"],
      "@mios/intelligence/*": ["packages/intelligence/src/*"],
      "@mios/ai": ["packages/ai/src/index.ts"],
      "@mios/ai/*": ["packages/ai/src/*"],
      "@mios/search": ["packages/search/src/index.ts"],
      "@mios/search/*": ["packages/search/src/*"],
      "@mios/ranking": ["packages/ranking/src/index.ts"],
      "@mios/ranking/*": ["packages/ranking/src/*"],
      "@mios/learning": ["packages/learning/src/index.ts"],
      "@mios/learning/*": ["packages/learning/src/*"],
      "@mios/evaluation": ["packages/evaluation/src/index.ts"],
      "@mios/evaluation/*": ["packages/evaluation/src/*"],
      "@mios/ui": ["packages/ui/src/index.tsx"],
      "@mios/ui/*": ["packages/ui/src/*"],
      "@mios/config": ["packages/config/src/index.ts"],
      "@mios/config/*": ["packages/config/src/*"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "apps/web/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist", "**/data"]
}
