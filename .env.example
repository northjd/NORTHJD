# ─────────────────────────────────────────────────────────────────────────────
# Market Intelligence OS — environment
# Copy to .env and fill in. Never commit .env.
# Everything here has a safe default or a documented "not configured" behaviour:
# the app boots, the vertical slice runs, and unavailable capabilities are shown
# as unavailable rather than faked.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: PGlite (real PostgreSQL 18 in WASM) exposed on the wire protocol by
# `npm run db:up`. Point this at any managed PostgreSQL for production instead.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
# Where the local PGlite server keeps its data directory and which port it binds.
PGLITE_DATA_DIR=./data/pglite
PGLITE_PORT=55432

# ── Session security ────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 48
# Required in production; in development a fixed insecure dev key is used if unset
# and a warning is logged.
SESSION_SECRET=

# ── AI provider (optional) ──────────────────────────────────────────────────
# Provider-agnostic. Leave AI_PROVIDER=deterministic to run with no model access at
# all: the pipeline and Companion then use extractive, rule-based generation that
# only ever restates sentences present in the evidence, and the UI labels every
# such output "Extractive (no LLM configured)". Nothing is invented either way.
#   deterministic | anthropic
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=4096
# Hard ceiling on model spend per pipeline run; run aborts when exceeded.
AI_MAX_USD_PER_RUN=2.00

# ── Embeddings (optional, prepared not implemented) ─────────────────────────
# EMBEDDING_PROVIDER=none | voyage
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=

# ── Voice (optional) ────────────────────────────────────────────────────────
# STT: browser | none | deepgram      TTS: browser | none | elevenlabs
# "browser" uses the user's own Web Speech API — no server credentials, no audio
# leaves the device, availability detected at runtime and reported honestly.
STT_PROVIDER=browser
TTS_PROVIDER=browser
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Audio is NOT persisted by default. Only set true with an explicit retention policy.
VOICE_PERSIST_AUDIO=false

# ── Ingestion ───────────────────────────────────────────────────────────────
# Sent on every outbound fetch so publishers can identify and contact us.
INGEST_USER_AGENT=MarketIntelligenceOS/0.1 (+contact: set-your-email)
INGEST_TIMEOUT_MS=15000
INGEST_MAX_BYTES=5242880
# Global kill switch for all network ingestion.
INGEST_ENABLED=true
# Refuse to fetch anything whose source policy has not passed rights review.
INGEST_REQUIRE_RIGHTS_REVIEW=true
# Comma-separated CIDRs/hosts the URL fetcher may never reach (SSRF guard adds
# all private ranges automatically).
INGEST_DENY_HOSTS=

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_SEMANTIC_SEARCH=false
FEATURE_VOICE=true
FEATURE_ADMIN=true
