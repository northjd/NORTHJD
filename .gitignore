node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# local database + object storage (never commit)
/data/
/.pgdata/
/storage/

# secrets
.env
.env.local
.env.*.local
!.env.example

# test + tooling output
# Anchored: an unanchored `coverage/` also matched the app's own /coverage and
# /admin/coverage routes, which were therefore never committed.
/coverage/
playwright-report/
test-results/
blob-report/
.playwright/
/.temporary/

# os / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Static export output and the files the export ships with it.
apps/web/out/
apps/web/public/palette.json
apps/web/public/evidence.json
apps/web/public/brief-pool.json
# Generated by build:feed on every build, like the three above, but was tracked — so
# every local build produced a 400-line diff nobody wanted to commit.
apps/web/public/feed.xml
.static-build-stash/
